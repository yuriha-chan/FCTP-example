{
  "listenHost": "0.0.0.0",
  "port": 8080,
  "dataDir": "/data",
  "origin": "https://authority.example.org",
  "workerIntervalMs": 1000,
  "adminSecretFile": "/run/secrets/admin-secret",
  "homeAccountName": "system.home",
  "registryAccountName": "system.registry",
  "serverDisplayName": "Example Authority",
  "homeDisplayName": "Example Authority Home",
  "registryDisplayName": "Example Authority Registry",
  "playerNames": ["player", "player-2"],
  "administratorNames": ["governor"],
  "administrator": "@governor@authority.example.org",
  "vesselNames": {},
  "startingPorts": ["https://west.example.org/objects/ports/east"],
  "accountPasswordsFile": "/run/secrets/account-passwords.json",
  "objectStorage": {
    "endpoint": "http://rustfs:9000",
    "publicBaseUrl": "http://127.0.0.1:4104/image-bucket",
    "region": "us-east-1",
    "bucket": "image-bucket",
    "accessKeyIdFile": "/run/secrets/s3-access-key",
    "secretAccessKeyFile": "/run/secrets/s3-secret-key",
    "forcePathStyle": true
  }
}
